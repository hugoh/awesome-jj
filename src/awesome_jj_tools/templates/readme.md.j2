% macro entry_line(entry, kind)
% if kind in ("list", "list_sorted")
- [{{ entry.name }}]({{ entry.url }}){{ " - " ~ entry.description if entry.description }}
% elif kind == "book"
- [{{ entry.name }}]({{ entry.url }}) - By {{ entry.author }}.
% elif kind == "dated"
- {{ entry.month }}/{{ entry.year }} [{{ entry.name }}]({{ entry.url }}) by {{ entry.author }}
% elif kind == "dated_video"
- {{ entry.month }}/{{ entry.year }} [{{ entry.name }}]({{ entry.url }}){{ " " ~ entry.suffix if entry.suffix }}
% endif
% endmacro
# {{ title }} [![Awesome](https://awesome.re/badge-flat.svg)](https://awesome.re)

> {{ description }}

{{ intro }}

This list merges the various out-of-date awesome-jj lists — see [SOURCES.md](SOURCES.md) for provenance and what was merged.

## Contents

% for section in sections
- [{{ section.title }}](#{{ section.slug }})
% for sub in section.subsections
  - [{{ sub.title }}](#{{ sub.slug }})
% endfor
% endfor

% for section in sections
## {{ section.title }}

% if section.kind == "tools"
% for sub in section.subsections
### {{ sub.title }}

% for entry in sub.entries
{{ entry_line(entry, "list_sorted") | trim }}
% endfor
% endfor
% else
% if section.intro
{{ section.intro }}

% endif
% for entry in section.entries
{{ entry_line(entry, section.kind) | trim }}
% endfor
% endif
% endfor
