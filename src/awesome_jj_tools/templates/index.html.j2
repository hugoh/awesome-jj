% macro entry_row(entry, kind)
% if kind in ("list", "list_sorted")
<li id="{{ entry.slug }}"><a href="{{ entry.url }}" data-pagefind-weight="2">{{ entry.name }}</a>{% if entry.description %} &mdash; {{ entry.description | md_links }}{% endif %}</li>
% elif kind == "book"
<li id="{{ entry.slug }}"><a href="{{ entry.url }}" data-pagefind-weight="2">{{ entry.name }}</a> &mdash; By {{ entry.author }}.{% if entry.description %} {{ entry.description | md_links }}{% endif %}</li>
% elif kind == "dated"
<li id="{{ entry.slug }}"><span class="date">{{ entry.month }}/{{ entry.year }}</span> <a href="{{ entry.url }}" data-pagefind-weight="2">{{ entry.name }}</a> by {{ entry.author }}</li>
% elif kind == "dated_video"
<li id="{{ entry.slug }}"><span class="date">{{ entry.month }}/{{ entry.year }}</span> <a href="{{ entry.url }}" data-pagefind-weight="2">{{ entry.name }}</a>{% if entry.suffix %} {{ entry.suffix }}{% endif %}</li>
% endif
% endmacro
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}</title>
<meta name="description" content="{{ page_description }}">
<meta name="robots" content="index, follow">
<link rel="canonical" href="{{ page_url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ title }}">
<meta property="og:title" content="{{ page_title }}">
<meta property="og:description" content="{{ page_description }}">
<meta property="og:url" content="{{ page_url }}">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ page_title }}">
<meta name="twitter:description" content="{{ page_description }}">
<link rel="icon" type="image/svg+xml" href="favicon.svg">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@anyblades/blades@3/css/blades.min.css">
<link rel="stylesheet" href="pagefind/pagefind-component-ui.css">
<style>
  :root { --pico-font-size: 100%; }
  main.container, footer.container { max-width: 46rem; }
  .date { color: var(--pico-muted-color); font-variant-numeric: tabular-nums; }
  .nav-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--pico-muted-color);
    margin: 1.5rem 0 0.5rem;
  }
  nav.toc { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 1.5rem; }
  nav.toc a {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--pico-muted-border-color);
    border-radius: var(--pico-border-radius);
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--pico-color);
  }
  :is(nav.toc, nav.tools-subnav) a[aria-current] {
    background: var(--pico-primary);
    border-color: var(--pico-primary);
    color: var(--pico-primary-inverse);
    font-weight: 600;
  }
  .tools-subnav-box {
    margin: -0.75rem 0 1.5rem;
    padding: 0.75rem 1rem 1rem;
    border: 1px solid var(--pico-muted-border-color);
    border-radius: var(--pico-border-radius);
    background: var(--pico-code-background-color);
  }
  .tools-subnav-box .nav-label { margin-top: 0; }
  nav.tools-subnav { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  nav.tools-subnav a {
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--pico-muted-border-color);
    border-radius: 999px;
    background: var(--pico-background-color);
    font-size: 0.8rem;
    text-decoration: none;
    color: var(--pico-color);
  }
  .header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  .header h1 { margin-bottom: 0; }
  .header-actions { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
  .gh-link {
    display: inline-flex; align-items: center; gap: 0.35rem;
    box-sizing: border-box; height: var(--pf-input-height, 36px); padding: 0 0.65rem;
    border: 1px solid var(--pico-muted-border-color);
    border-radius: var(--pf-border-radius, 6px);
    font-size: 0.85rem; text-decoration: none; color: var(--pico-color);
  }
  .search { display: flex; }
  .gh-link:hover { border-color: var(--pico-primary); }
  .gh-link svg { width: 1em; height: 1em; fill: currentColor; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  :root {
    --pf-text: var(--pico-color);
    --pf-text-secondary: var(--pico-muted-color);
    --pf-text-muted: var(--pico-muted-color);
    --pf-background: var(--pico-background-color);
    --pf-border: var(--pico-muted-border-color);
    --pf-border-focus: var(--pico-primary-focus);
    --pf-skeleton: var(--pico-muted-border-color);
    --pf-skeleton-shine: var(--pico-code-background-color);
    --pf-hover: var(--pico-dropdown-hover-background-color);
    --pf-mark: var(--pico-color);
    --pf-outline-focus: var(--pico-primary-focus);
    --pf-modal-backdrop: var(--pico-modal-overlay-background-color);
  }
</style>
</head>
<body>
<main class="container"{% if page.filename != "index.html" %} data-pagefind-body{% endif %}>

<div class="header">
% if page.filename == "index.html"
<h1 id="{{ section.slug }}">{{ title }}</h1>
% else
<h1 id="{{ section.slug }}">{{ title }} - {{ section.title }}</h1>
% endif
<div class="header-actions">
<a class="gh-link" href="https://github.com/hugoh/awesome-jj" aria-label="View hugoh/awesome-jj on GitHub"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>GitHub</a>
<a class="gh-link" href="https://github.com/hugoh/awesome-jj" aria-label="Star hugoh/awesome-jj on GitHub"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>Star</a>
<div class="search">
  <pagefind-config bundle-path="./"></pagefind-config>
  <pagefind-modal-trigger></pagefind-modal-trigger>
  <pagefind-modal>
    <pagefind-modal-header>
      <pagefind-input></pagefind-input>
    </pagefind-modal-header>
    <pagefind-modal-body>
      <pagefind-filter-pane label="Category"></pagefind-filter-pane>
      <pagefind-summary></pagefind-summary>
      <pagefind-results></pagefind-results>
    </pagefind-modal-body>
    <pagefind-modal-footer>
      <pagefind-keyboard-hints></pagefind-keyboard-hints>
    </pagefind-modal-footer>
  </pagefind-modal>
</div>
</div>
</div>
<p class="date">{{ description }}</p>
<p>{{ intro }} Source and contribution guide: <a href="https://github.com/hugoh/awesome-jj">hugoh/awesome-jj</a>.</p>
<p class="date">Last updated: {{ updated_at }}</p>

<span class="nav-label">Sections</span>
<nav class="toc">
% for item in nav
<a href="{{ item.href }}"{% if item.filename == page.filename or (item.href == "./" and page.tools_nav) %} aria-current="page"{% endif %}>{{ item.title }}</a>
% endfor
</nav>

% if page.tools_nav
<div class="tools-subnav-box">
<span class="nav-label">Tools categories</span>
<nav class="tools-subnav">
% for item in page.tools_nav
<a href="{{ item.filename }}"{% if item.filename == page.filename %} aria-current="page"{% endif %}>{{ item.title }}</a>
% endfor
</nav>
</div>
% endif

<span class="visually-hidden" data-pagefind-meta="title">{{ page_title }}</span>
% if section.kind == "tools"
% for sub in section.subsections
<h3 id="{{ sub.slug }}">{{ sub.title }}</h3>
<ul>
% for entry in sub.entries
{{ entry_row(entry, "list_sorted") | trim }}
% endfor
</ul>
% endfor
% else
<span class="visually-hidden" data-pagefind-filter="category">{{ section.title }}</span>
% if section.intro
<p>{{ section.intro }}</p>
% endif
<ul>
% for entry in section.entries
{{ entry_row(entry, section.kind) | trim }}
% endfor
</ul>
% endif

</main>

<footer class="container">
Generated from <a href="https://github.com/hugoh/awesome-jj/blob/main/data/entries.yaml">data/entries.yaml</a>.
Source: <a href="https://github.com/hugoh/awesome-jj">hugoh/awesome-jj</a>.
</footer>

<script src="pagefind/pagefind-component-ui.js" type="module"></script>
<script>
  document.addEventListener("click", (event) => {
    if (event.target.closest("pagefind-results a")) {
      document.querySelector("pagefind-modal")?.close();
    }
  });
</script>
</body>
</html>
