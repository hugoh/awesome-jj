% macro entry_row(entry, kind)
% if kind in ("list", "list_sorted")
<li id="{{ entry.slug }}"><a href="{{ entry.url }}">{{ entry.name }}</a>{% if entry.description %} &mdash; {{ entry.description | md_links }}{% endif %}</li>
% elif kind == "book"
<li id="{{ entry.slug }}"><a href="{{ entry.url }}">{{ entry.name }}</a> &mdash; By {{ entry.author }}.</li>
% elif kind == "dated"
<li id="{{ entry.slug }}"><span class="date">{{ entry.month }}/{{ entry.year }}</span> <a href="{{ entry.url }}">{{ entry.name }}</a> by {{ entry.author }}</li>
% elif kind == "dated_video"
<li id="{{ entry.slug }}"><span class="date">{{ entry.month }}/{{ entry.year }}</span> <a href="{{ entry.url }}">{{ entry.name }}</a>{% if entry.suffix %} {{ entry.suffix }}{% endif %}</li>
% endif
% endmacro
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="robots" content="index, follow">
<link rel="canonical" href="{{ url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ title }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ url }}">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<link rel="icon" href="data:,">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
<link rel="stylesheet" href="pagefind/pagefind-ui.css">
<style>
  :root { --pico-font-size: 100%; }
  main.container, footer.container { max-width: 736px; }
  .date { color: var(--pico-muted-color); font-variant-numeric: tabular-nums; }
  nav.toc { columns: 2; margin: 1.5rem 0; }
  nav.toc a { display: block; margin: 0.15rem 0; font-size: 0.9rem; }
  #search { margin: 1.5rem 0; }
</style>
</head>
<body>
<main class="container" data-pagefind-body>

<h1>{{ title }}</h1>
<p class="date">{{ description }}</p>
<p>{{ intro }} Source and contribution guide: <a href="https://github.com/hugoh/awesome-jj">hugoh/awesome-jj</a>.</p>
<p class="date">Last updated: {{ updated_at }}</p>

<div id="search"></div>

<nav class="toc">
% for section in sections
<a href="#{{ section.slug }}">{{ section.title }}</a>
% endfor
</nav>

% for section in sections
<h2 id="{{ section.slug }}">{{ section.title }}</h2>
% if section.kind == "tools"
% for sub in section.subsections
<h3 id="{{ sub.slug }}">{{ sub.title }}</h3>
<ul>
% for entry in sub.entries
{{ entry_row(entry, "list_sorted") | trim }}
% endfor
</ul>
% endfor
% else
% if section.intro
<p>{{ section.intro }}</p>
% endif
<ul>
% for entry in section.entries
{{ entry_row(entry, section.kind) | trim }}
% endfor
</ul>
% endif
% endfor

</main>

<footer class="container">
Generated from <a href="https://github.com/hugoh/awesome-jj/blob/main/data/entries.yaml">data/entries.yaml</a>.
Source: <a href="https://github.com/hugoh/awesome-jj">hugoh/awesome-jj</a>.
</footer>

<script src="pagefind/pagefind-ui.js"></script>
<script>
  window.addEventListener("DOMContentLoaded", () => {
    new PagefindUI({ element: "#search", showSubResults: true, focusOnSlash: true });
  });
</script>
</body>
</html>
