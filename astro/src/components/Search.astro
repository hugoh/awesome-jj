---
// Same Pagefind modal + category filter as the Jinja site; config/CSS/JS come
// from astro-pagefind (bundled from npm, no CDN).
---

<pagefind-modal-trigger></pagefind-modal-trigger>
<pagefind-modal>
  <pagefind-modal-header><pagefind-input></pagefind-input></pagefind-modal-header>
  <pagefind-modal-body>
    <pagefind-filter-pane label="Category"></pagefind-filter-pane>
    <pagefind-summary></pagefind-summary>
    <pagefind-results></pagefind-results>
  </pagefind-modal-body>
  <pagefind-modal-footer><pagefind-keyboard-hints></pagefind-keyboard-hints></pagefind-modal-footer>
</pagefind-modal>

<script>
  // A result linking to a same-page anchor doesn't navigate, so close the modal by hand.
  document.addEventListener("click", (event) => {
    if ((event.target as Element).closest("pagefind-results a")) {
      document.querySelector("pagefind-modal")?.close();
    }
  });
</script>
